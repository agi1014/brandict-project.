# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python/
env/
venv/
.venv/
*.egg-info/
.pytest_cache/
.coverage
.mypy_cache/

# Jupyter Notebook
.ipynb_checkpoints

# Data
data/*.csv  # If your data is very large and you only store pre-processed in repo
temp_uploads/ # Temporary files generated by FastAPI

# Machine Learning
*.pt          # PyTorch models
*.pth         # PyTorch models
*.h5          # Keras models
*.onnx        # ONNX models
runs/         # YOLOv8 training runs output
weights/      # Model weights (if very large, typically stored outside Git)
data.yaml     # YOLO config (if sensitive paths)

# IDEs
.idea/
.vscode/

# Docker
.dockerignore # This is for Docker, not Git, but often excluded
Dockerfile.tmp # Any temporary Docker files